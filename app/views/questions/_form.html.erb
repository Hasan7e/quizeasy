<%= form_with(model: question) do |form| %>
  <% if question.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(question.errors.count, "error") %> prohibited this question from being saved:</h2>

      <ul>
        <% question.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <div>
  <%= form.label :quiz_id, "Select Quiz", style: "display: block" %>

  <%= form.collection_select :quiz_id, Quiz.all, :id,
        ->(quiz) { "#{quiz.id} — #{quiz.title}" },
        { prompt: "Choose a quiz" },
        { class: "form-select", style: "width: 100%;" } %>
</div>


  <div>
    <%= form.label :text, style: "display: block" %>
    <%= form.text_field :text %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
