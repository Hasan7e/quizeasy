<%= form_with(model: choice) do |form| %>
  <% if choice.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(choice.errors.count, "error") %> prohibited this choice from being saved:</h2>

      <ul>
        <% choice.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>



<div class="mb-3">
  <%= form.label :question_id, "Question", class: "form-label" %>
  <%= form.collection_select :question_id,
        Question.includes(:quiz).all,
        :id,                     # value sent to the server
        :label_for_choice_form,  # label shown to User
        {},
        class: "form-select" %>
</div>



  <div>
    <%= form.label :question_id, style: "display: block" %>
    <%= form.text_field :question_id %>
  </div>

  <div>
    <%= form.label :body, style: "display: block" %>
    <%= form.text_field :body %>
  </div>

  <div>
    <%= form.label :correct, style: "display: block" %>
    <%= form.checkbox :correct %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
