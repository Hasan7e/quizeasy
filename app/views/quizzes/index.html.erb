<p style="color: green"><%= notice %></p>

<% content_for :title, "Quizzes" %>

<h1>Quizzes</h1>

<div id="quizzes">
  <% @quizzes.each do |quiz| %>
    <%= render quiz %>
    <p>
      <%= link_to "Show this quiz", quiz %>
      <%= link_to "Take quiz", take_quiz_path(quiz), class: "btn btn-sm btn-success" %>

    </p>
  <% end %>
</div>

<%= link_to "New quiz", new_quiz_path %>
