<div class="d-flex justify-content-center my-4">
  <div class="w-75" style="max-width: 600px;">
    
    <!-- RAW HTML form (allows SQL injection) -->
    <form action="/quizzes" method="get" class="input-group" autocomplete="off"
      data-turbo="false">
      <input 
        type="text" 
        name="q" 
        value="<%= params[:q] %>" 
        class="form-control" 
        placeholder="Search quizzes..."
      >

      <button type="submit" class="btn btn-primary">Search</button>
    </form>

  </div>
</div>


 <!--  (allows SQL injection) in the browser (quizzes?debug=1) reveals all the user sensitive data  -->
<% if params[:debug].present? %>
  <div class="container my-4">
    <div class="alert alert-danger">
      ⚠ Sensitive Data Exposure: Showing ALL user data!
    </div>

    <h5>Users Table</h5>
    <pre class="bg-dark text-light p-3 rounded">
<%= User.all.map(&:attributes).to_json.html_safe %>
    </pre>

    <h5 class="mt-4">Quizzes (Results from SQL Injection)</h5>
    <pre class="bg-dark text-light p-3 rounded">
<%= @quizzes.map(&:attributes).to_json.html_safe %>
    </pre>
  </div>
<% end %>




<br/>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% @quizzes.each do |quiz| %>
    <div class="col">
      <div class="card h-100 shadow-sm">

        <div class="card-body text-center">
          <h4 class="card-title mb-2"><%= quiz.title %></h4>
          <p class="card-text text-muted">
            <%= truncate(quiz.description, length: 80) %>
          </p>
        </div>

        <div class="card-footer bg-white border-0 d-flex justify-content-center gap-2 pb-3">
          <%= link_to "Details", quiz_path(quiz), class: "btn btn-outline-primary btn-sm" %>
          <%= link_to "Take Quiz", take_quiz_path(quiz), class: "btn btn-success btn-sm" %>
        </div>

      </div>
    </div>
  <% end %>
</div>

<div class="text-center mt-4">
  <%= link_to "New Quiz", new_quiz_path, class: "btn btn-primary" %>
</div>

