<h1 class="mb-4 mt-4 text-center">Welcome to QuizEasy</h1>

<h3 class=" mb-4 text-center  lead text-muted">Please choosoe a quiz category from below</h3>
<br/>

<%= form_with url: quizzes_path, method: :get, local: true, class: "mb-4" do %>
  <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Search quizzes..." %>
<% end %>

<br/>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% @quizzes.each do |quiz| %>
    <div class="col">
      <div class="card h-100 shadow-sm">

        <div class="card-body text-center">
          <h4 class="card-title mb-2"><%= quiz.title %></h4>
          <p class="card-text text-muted">
            <%= truncate(quiz.description, length: 80) %>
          </p>
        </div>

        <div class="card-footer bg-white border-0 d-flex justify-content-center gap-2 pb-3">
          <%= link_to "Details", quiz_path(quiz), class: "btn btn-outline-primary btn-sm" %>
          <%= link_to "Take Quiz", take_quiz_path(quiz), class: "btn btn-success btn-sm" %>
        </div>

      </div>
    </div>
  <% end %>
</div>

<div class="text-center mt-4">
  <%= link_to "New Quiz", new_quiz_path, class: "btn btn-primary" %>
</div>

